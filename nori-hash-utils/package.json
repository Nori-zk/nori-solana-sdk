{
    "name": "@nori-zk/nori-hash-utils",
    "version": "0.0.1",
    "description": "Proof queue request leaf and Merkle witness hashing, compiled from the SP1 guest's nori-hash to WebAssembly",
    "license": "MIT",
    "type": "module",
    "main": "pkg/nori_hash_utils.js",
    "types": "pkg/nori_hash_utils.d.ts",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "files": [
        "pkg/nori_hash_utils_bg.wasm",
        "pkg/nori_hash_utils_bg.wasm.d.ts",
        "pkg/nori_hash_utils.js",
        "pkg/nori_hash_utils_bg.js",
        "pkg/nori_hash_utils.d.ts",
        "README.md"
    ],
    "sideEffects": [
        "./pkg/nori_hash_utils.js",
        "./pkg/snippets/*"
    ],
    "scripts": {
        "clean": "rimraf pkg",
        "build": "npm run clean && wasm-pack build --no-pack --features wasm"
    }
}
