{
    "name": "@nori-zk/nori-solana-sdk",
    "private": true,
    "version": "0.1.1",
    "type": "module",
    "workspaces": [
        "ethereum",
        "sdk"
    ],
    "devDependencies": {
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-typescript": "^7.28.5",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "eslint": "^9.39.2",
        "jest": "^30.2.0",
        "npm-workspaces-publish-tool": "0.0.18",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.1.0",
        "typescript-eslint": "^8.55.0"
    },
    "scripts": {
        "preinstall": "npm run install:sbf-tools",
        "install:sbf-tools": "cargo build-sbf --install-only --force-tools-install --tools-version v1.54",
        "build:program": "CFLAGS=\"-isystem $HOME/.cache/solana/v1.54/platform-tools/llvm/sbpf/include\" cargo build-sbf --manifest-path programs/token/Cargo.toml",
        "build:idl": "anchor idl build -p token -o idl/token.json -t idl/token.ts -- --locked",
        "build:js": "npm run build --workspaces --if-present",
        "build": "npm run build:program && npm run build:idl && npm run build:js",
        "lint": "npm run lint --workspaces --if-present",
        "format": "npm run format --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test-ci": "npm run test-ci --workspaces --if-present",
        "publish": "nw-publish",
        "clean:modules": "rm -rf node_modules */node_modules */*/node_modules */*/*/node_modules",
        "reinstall": "npm run clean:modules && rm -f package-lock.json && npm install",
        "reinstall:ci": "npm run clean:modules && npm ci"
    }
}
